{
  "name": "microservices-architecture-nestjs",
  "version": "1.0.0",
  "description": "Microservices reference architecture with NestJS 11.1.x, Express 5, Apollo Server 5, GraphQL 17, TypeORM 11, Mongoose 8, OpenTelemetry 0.221 and nestjs-otel 8.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build shared && nest build rabbitmq-queue && nest build music-library-api && nest build utils && nest build music-discovery-api && nest build music-library-grpc && nest build integration-events && nest build distributed-transactions && nest build spotify-monolith && nest build music-library-ms && nest build accounts-ms && nest build mobile-bff && nest build music-discovery-ms && nest build mailing-ms && nest build media-ms && nest build web-bff && nest build merch-products-ms && nest build merch-orders-ms && nest build merch-payment-ms && nest build user-purchases-ms",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:infra": "cd infrastructure/local && docker compose --env-file ../../.env up -d && docker ps",
    "stop:infra": "cd infrastructure/local && docker-compose down && docker ps",
    "start:e2e-infra": "cd infrastructure/test && docker-compose up -d && docker ps",
    "stop:e2e-infra": "cd infrastructure/test && docker-compose down && docker ps",
    "start:frontend": "cd scripts && ./start-frontend.sh",
    "start:spotify-monolith": "npx nest start -w spotify-monolith",
    "start:music-library": "npx nest start -w music-library-ms",
    "job:create-music-library": "venv/bin/python jobs/create_music_library.py",
    "start:discovery": "npx nest start -w music-discovery-ms",
    "start:accounts": "npx nest start -w accounts-ms",
    "start:mobile-bff": "npx nest start -w mobile-bff",
    "start:mailing": "npx nest start -w mailing-ms",
    "start:media": "npx nest start -w media-ms",
    "start:web-bff": "npx nest start -w web-bff",
    "start:merch-products": "npx nest start -w merch-products-ms",
    "start:merch-orders": "npx nest start -w merch-orders-ms",
    "e2e:all": "npm run e2e:music-library && npm run e2e:mobile-bff && npm run e2e:music-discovery && npm run e2e:spotify-monolith && npm run e2e:web-bff && npm run e2e:media && npm run e2e:accounts && npm run e2e:mailing && npm run e2e:merch-orders && npm run e2e:merch-payment && npm run e2e:merch-products && npm run e2e:user-purchases",
    "e2e:music-library": "env MUSIC_LIBRARY_MS_DATABASE_HOST=localhost MUSIC_LIBRARY_MS_DATABASE_PORT=5555 MUSIC_LIBRARY_MS_DATABASE_NAME=test MUSIC_LIBRARY_MS_DATABASE_USER=test MUSIC_LIBRARY_MS_DATABASE_PASS=test jest --config ./apps/music-library-ms/test/jest-e2e.json --maxWorkers 1",
    "e2e:mobile-bff": "env jest --config ./apps/mobile-bff/test/jest-e2e.json --maxWorkers 1",
    "e2e:music-discovery": "env MUSIC_DISCOVERY_MS_DATABASE_HOST=localhost MUSIC_DISCOVERY_MS_DATABASE_NAME=test MUSIC_DISCOVERY_MS_DATABASE_PORT=27020 MUSIC_DISCOVERY_MS_DATABASE_USER=test MUSIC_DISCOVERY_MS_DATABASE_PASS=test jest --detectOpenHandles --config ./apps/music-discovery-ms/test/jest-e2e.json --maxWorkers 1 ",
    "e2e:spotify-monolith": "env jest --config ./apps/spotify-monolith/test/jest-e2e.json --maxWorkers 1",
    "e2e:web-bff": "env jest --config ./apps/web-bff/test/jest-e2e.json --maxWorkers 1",
    "e2e:media": "env jest --config ./apps/media-ms/test/jest-e2e.json --maxWorkers 1",
    "e2e:accounts": "env ACCOUNTS_MS_DATABASE_HOST=localhost ACCOUNTS_MS_DATABASE_PORT=5555 ACCOUNTS_MS_DATABASE_NAME=test ACCOUNTS_MS_DATABASE_USER=test ACCOUNTS_MS_DATABASE_PASS=test jest --config ./apps/accounts-ms/test/jest-e2e.json --maxWorkers 1",
    "e2e:mailing": "env jest --config ./apps/mailing-ms/test/jest-e2e.json --maxWorkers 1",
    "e2e:merch-orders": "env jest --config ./apps/merch-orders-ms/test/jest-e2e.json --maxWorkers 1",
    "e2e:merch-payment": "env jest --config ./apps/merch-payment-ms/test/jest-e2e.json --maxWorkers 1",
    "e2e:merch-products": "env jest --config ./apps/merch-products-ms/test/jest-e2e.json --maxWorkers 1",
    "e2e:user-purchases": "env jest --config ./apps/user-purchases-ms/test/jest-e2e.json --maxWorkers 1",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "create:clean-module": "./scripts/create-hexagonal-module.sh",
    "create:app": "node ./scripts/javascript/create-app.mjs",
    "start:merch-payment": "npx nest start -w merch-payment-ms",
    "start:user-purchases": "npx nest start -w user-purchases-ms"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.476.0",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/microservices": "^11.1.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^1.30.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-amqplib": "^0.50.0",
    "@opentelemetry/instrumentation-express": "^0.52.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.55.0",
    "@opentelemetry/instrumentation-pino": "^0.50.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.3",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "graphql": "^17.0.0",
    "http-proxy-middleware": "^3.0.0",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "nestjs-otel": "^8.0.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "short-uuid": "^4.2.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/libs/",
      "<rootDir>/apps/"
    ],
    "moduleNameMapper": {
      "^@lib/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@lib/rabbitmq-queue(|/.*)$": "<rootDir>/libs/rabbitmq-queue/src/$1",
      "^@lib/music-library-api(|/.*)$": "<rootDir>/libs/music-library-api/src/$1",
      "^@lib/utils(|/.*)$": "<rootDir>/libs/utils/src/$1",
      "^@lib/music-discovery-api(|/.*)$": "<rootDir>/libs/music-discovery-api/src/$1",
      "^@lib/music-library-grpc(|/.*)$": "<rootDir>/libs/music-library-grpc/src/$1",
      "^@lib/integration-events(|/.*)$": "<rootDir>/libs/integration-events/src/$1",
      "^@lib/distributed-transactions(|/.*)$": "<rootDir>/libs/distributed-transactions/src/$1"
    }
  }
}
